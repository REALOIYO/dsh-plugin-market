{
  "name": "dsh-plugin-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin market index (format 1) generated from npm",
  "scripts": {
    "build": "node build-index.mjs",
    "build:cache": "node build-index.mjs --from-cache",
